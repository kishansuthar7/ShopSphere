<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Your orders"/><%@ include file="fragments/header.jsp" %><h1 class="fw-bold">Your orders</h1><p class="text-secondary mb-4">Track your ShopSphere purchases.</p><c:if test="${not empty param.placed}"><div class="alert alert-success">Order #<c:out value="${param.placed}"/> placed successfully. Thank you!</div></c:if><div class="panel p-3 p-md-4"><c:choose><c:when test="${empty orders}"><div class="empty-state"><h3>No orders yet</h3><p>Your order history will appear here.</p><a href="${pageContext.request.contextPath}/products" class="btn btn-dark">Start shopping</a></div></c:when><c:otherwise><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Order</th><th>Date</th><th>Total</th><th>Payment</th><th>Status</th></tr></thead><tbody><c:forEach var="o" items="${orders}"><tr><td>#<c:out value="${o.id}"/></td><td><c:out value="${o.created}"/></td><td>₹<c:out value="${o.total}"/></td><td><span class="badge text-bg-success"><c:out value="${o.payment}"/></span></td><td><span class="badge text-bg-primary"><c:out value="${o.status}"/></span></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></div><%@ include file="fragments/footer.jsp" %>
