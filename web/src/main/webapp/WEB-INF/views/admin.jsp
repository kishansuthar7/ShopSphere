<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Admin dashboard"/><%@ include file="fragments/header.jsp" %><div class="d-flex flex-wrap justify-content-between align-items-center mb-4"><div><span class="eyebrow">CONTROL CENTER</span><h1 class="fw-bold mt-1">Admin dashboard</h1></div><span class="badge text-bg-dark p-2">ADMIN</span></div><c:if test="${param.updated eq '1'}"><div class="alert alert-success">Changes saved successfully.</div></c:if><c:if test="${not empty adminError}"><div class="alert alert-danger"><c:out value="${adminError}"/></div></c:if><div class="row g-3 mb-5"><div class="col-md-4"><div class="stat-card"><span>Customers</span><strong><c:out value="${customers}"/></strong></div></div><div class="col-md-4"><div class="stat-card"><span>Orders</span><strong><c:out value="${ordersCount}"/></strong></div></div><div class="col-md-4"><div class="stat-card"><span>Gross sales</span><strong>₹<c:out value="${revenue}"/></strong></div></div></div><div class="row g-4"><div class="col-lg-5"><div class="panel p-4"><h4 class="fw-bold mb-3">Add a product</h4><form method="post" action="${pageContext.request.contextPath}/admin"><input type="hidden" name="action" value="add"><label class="form-label">Product name</label><input class="form-control" name="name" maxlength="160" required><label class="form-label mt-3">Brand</label><input class="form-control" name="brand" maxlength="100" required><label class="form-label mt-3">Description</label><textarea class="form-control" name="description" maxlength="2000" required></textarea><div class="row"><div class="col-6"><label class="form-label mt-3">Price (₹)</label><input class="form-control" type="number" min="0" step="0.01" name="price" required></div><div class="col-6"><label class="form-label mt-3">Stock</label><input class="form-control" type="number" min="0" name="stock" required></div></div><label class="form-label mt-3">Image URL (optional)</label><input class="form-control" type="url" name="imageUrl"><button class="btn btn-dark w-100 mt-4">Add product</button></form></div></div><div class="col-lg-7"><div class="panel p-4"><h4 class="fw-bold mb-3">Product inventory</h4><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Product</th><th>Price</th><th>Stock</th><th>Action</th></tr></thead><tbody><c:forEach var="product" items="${products}"><tr><td><strong><c:out value="${product.name}"/></strong><div class="small text-secondary"><c:out value="${product.brand}"/></div></td><td>₹<c:out value="${product.price}"/></td><td><c:out value="${product.stock}"/></td><td><form method="post" action="${pageContext.request.contextPath}/admin"><input type="hidden" name="productId" value="${product.productId}"><input type="hidden" name="action" value="deactivate"><button class="btn btn-outline-danger btn-sm">Deactivate</button></form></td></tr></c:forEach></tbody></table></div></div></div></div><%@ include file="fragments/footer.jsp" %>
