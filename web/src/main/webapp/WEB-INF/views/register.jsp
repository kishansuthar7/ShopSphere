<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Create account"/><%@ include file="fragments/header.jsp" %><div class="auth-wrap"><div class="auth-card"><span class="eyebrow">JOIN THE COMMUNITY</span><h1 class="fw-bold mt-2">Create account</h1><p class="text-secondary">It takes less than a minute.</p><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/register"><label class="form-label mt-2">Full name</label><input class="form-control" name="name" minlength="2" maxlength="100" required><label class="form-label mt-3">Email</label><input class="form-control" type="email" name="email" maxlength="160" required autocomplete="email"><label class="form-label mt-3">Mobile (optional)</label><input class="form-control" name="mobile" maxlength="20"><label class="form-label mt-3">Password</label><input class="form-control" type="password" name="password" minlength="8" required autocomplete="new-password"><div class="form-text">Use at least 8 characters.</div><button class="btn btn-dark btn-lg w-100 mt-4">Create account</button></form><p class="text-center mt-4 mb-0">Already registered? <a href="${pageContext.request.contextPath}/login">Sign in</a></p></div></div><%@ include file="fragments/footer.jsp" %>
