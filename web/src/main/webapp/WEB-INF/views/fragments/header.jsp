<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><c:out value="${pageTitle}" default="ShopSphere"/> | ShopSphere</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/style.css" rel="stylesheet"></head><body><nav class="navbar navbar-expand-lg navbar-dark shop-nav"><div class="container"><a class="navbar-brand fw-bold" href="${pageContext.request.contextPath}/products">ShopSphere<span class="brand-dot">.</span></a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><form class="d-flex mx-lg-auto my-3 my-lg-0 search-form" action="${pageContext.request.contextPath}/products"><input class="form-control" name="q" placeholder="Search products..." value="<c:out value='${param.q}'/>"><button class="btn btn-light" type="submit">Search</button></form><div class="navbar-nav ms-lg-3 align-items-lg-center"><a class="nav-link" href="${pageContext.request.contextPath}/products">Shop</a><a class="nav-link" href="${pageContext.request.contextPath}/cart">Cart</a><c:choose><c:when test="${not empty sessionScope.user}"><a class="nav-link" href="${pageContext.request.contextPath}/orders">Orders</a><c:if test="${sessionScope.user.role eq 'ADMIN'}"><a class="nav-link" href="${pageContext.request.contextPath}/admin">Admin</a></c:if><span class="nav-link small text-white-50">Hi, <c:out value="${sessionScope.user.name}"/></span><a class="btn btn-outline-light btn-sm ms-lg-2" href="${pageContext.request.contextPath}/logout">Logout</a></c:when><c:otherwise><a class="nav-link" href="${pageContext.request.contextPath}/login">Login</a><a class="btn btn-warning btn-sm ms-lg-2" href="${pageContext.request.contextPath}/register">Create account</a></c:otherwise></c:choose></div></div></div></nav><main class="container py-4"><c:if test="${not empty param.message}"><div class="alert alert-success"><c:out value="${param.message}"/></div></c:if><c:if test="${not empty param.error}"><div class="alert alert-danger"><c:out value="${param.error}"/></div></c:if>
