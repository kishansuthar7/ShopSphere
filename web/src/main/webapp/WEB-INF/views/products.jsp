<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Shop products"/><%@ include file="fragments/header.jsp" %>
<section class="hero p-4 p-md-5 mb-5"><div class="row align-items-center"><div class="col-lg-7"><span class="eyebrow">YOUR EVERYDAY MARKETPLACE</span><h1 class="display-5 fw-bold mt-3">Good finds.<br><span class="accent">Better everyday.</span></h1><p class="lead text-secondary mt-3">Discover useful essentials, thoughtful design, and prices that make sense.</p><a class="btn btn-dark btn-lg mt-2" href="#catalog">Explore products</a></div><div class="col-lg-5 d-none d-lg-block"><div class="hero-art"><div class="hero-circle"></div><div class="hero-card">✦<br><small>FIND YOUR<br>FAVOURITES</small></div></div></div></div></section>
<div id="catalog" class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3"><div><span class="eyebrow">CURATED FOR YOU</span><h2 class="fw-bold mt-1">Featured products</h2></div><span class="text-secondary"><c:out value="${products.size()}"/> products</span></div>
<div class="row g-4"><c:forEach var="product" items="${products}"><div class="col-12 col-sm-6 col-lg-4"><article class="product-card h-100"><div class="product-image"><c:choose><c:when test="${not empty product.imageUrl}"><img src="<c:out value='${product.imageUrl}'/>" alt="<c:out value='${product.name}'/>" onerror="this.style.display='none';this.nextElementSibling.style.display='grid'"><div class="image-fallback" style="display:none">✦</div></c:when><c:otherwise><div class="image-fallback">✦</div></c:otherwise></c:choose><c:if test="${product.discount gt 0}"><span class="discount-pill"><c:out value="${product.discount}"/>% OFF</span></c:if></div><div class="p-3 p-lg-4"><div class="text-secondary small"><c:out value="${product.brand}"/></div><h5 class="fw-bold mt-1"><c:out value="${product.name}"/></h5><p class="text-secondary small product-desc"><c:out value="${product.description}"/></p><div class="d-flex align-items-center gap-2 mb-3"><span class="price">₹<c:out value="${product.salePrice}"/></span><c:if test="${product.discount gt 0}"><del class="text-secondary small">₹<c:out value="${product.price}"/></del></c:if></div><div class="d-flex justify-content-between align-items-center"><span class="small ${product.stock gt 0 ? 'text-success' : 'text-danger'}"><c:choose><c:when test="${product.stock gt 0}">In stock · <c:out value="${product.stock}"/></c:when><c:otherwise>Out of stock</c:otherwise></c:choose></span><form action="${pageContext.request.contextPath}/cart" method="post"><input type="hidden" name="productId" value="${product.productId}"><input type="hidden" name="quantity" value="1"><button class="btn btn-dark btn-sm" ${product.stock le 0 ? 'disabled' : ''}>Add to cart +</button></form></div></div></article></div></c:forEach></div><c:if test="${empty products}"><div class="empty-state"><h3>No products found</h3><p>Try a different search term.</p><a href="${pageContext.request.contextPath}/products" class="btn btn-dark">Clear search</a></div></c:if>
<%@ include file="fragments/footer.jsp" %>
