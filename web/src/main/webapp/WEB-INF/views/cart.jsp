<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Your cart"/><%@ include file="fragments/header.jsp" %><h1 class="fw-bold mb-4">Your cart</h1><c:choose><c:when test="${empty items}"><div class="empty-state"><div class="display-4">🛍</div><h3 class="mt-3">Your cart is waiting</h3><p class="text-secondary">Add something you love and it will show up here.</p><a class="btn btn-dark" href="${pageContext.request.contextPath}/products">Browse products</a></div></c:when><c:otherwise><div class="row g-4"><div class="col-lg-8"><div class="panel p-3 p-md-4"><c:forEach var="item" items="${items}"><div class="cart-line"><div class="flex-grow-1"><h5 class="fw-bold"><c:out value="${item.name}"/></h5><span class="text-secondary">₹<c:out value="${item.price}"/> × <c:out value="${item.quantity}"/></span></div><strong>₹<c:out value="${item.lineTotal}"/></strong><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="productId" value="${item.id}"><input type="hidden" name="action" value="remove"><button class="btn btn-outline-danger btn-sm ms-3">Remove</button></form></div></c:forEach></div></div><div class="col-lg-4"><div class="panel p-4"><h5 class="fw-bold">Order summary</h5><div class="d-flex justify-content-between my-3"><span>Subtotal</span><strong>₹<c:out value="${total}"/></strong></div><div class="d-flex justify-content-between mb-3"><span>Delivery</span><span class="text-success">Free</span></div><hr><div class="d-flex justify-content-between fs-5"><strong>Total</strong><strong>₹<c:out value="${total}"/></strong></div><a class="btn btn-dark btn-lg w-100 mt-4" href="${pageContext.request.contextPath}/checkout">Continue to checkout</a></div></div></div></c:otherwise></c:choose><%@ include file="fragments/footer.jsp" %>
