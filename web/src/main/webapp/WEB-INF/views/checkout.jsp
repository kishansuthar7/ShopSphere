<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Checkout"/><%@ include file="fragments/header.jsp" %><div class="row justify-content-center"><div class="col-lg-8"><div class="panel p-4 p-md-5"><span class="eyebrow">ALMOST THERE</span><h1 class="fw-bold mt-2">Delivery details</h1><p class="text-secondary">This student demo uses a mock payment; no real money is charged.</p><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/checkout"><label class="form-label">Address</label><input class="form-control" name="address" maxlength="255" required><div class="row"><div class="col-md-6"><label class="form-label mt-3">City</label><input class="form-control" name="city" required maxlength="100"></div><div class="col-md-6"><label class="form-label mt-3">State</label><input class="form-control" name="state" required maxlength="100"></div></div><label class="form-label mt-3">PIN code</label><input class="form-control" name="pincode" pattern="[0-9A-Za-z -]{4,12}" required maxlength="12"><div class="alert alert-info mt-4 mb-0">Payment method: <strong>Mock payment (demo only)</strong></div><button class="btn btn-dark btn-lg w-100 mt-4">Place order</button></form></div></div></div><%@ include file="fragments/footer.jsp" %>
